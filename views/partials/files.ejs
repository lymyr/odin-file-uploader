<% if (currentFolder.file) {%>
    <% for (const file of currentFolder.file) {%>
        <% if (locals.updateFile?.name != file.name) {%>
            <tr>
                <td><%= file.name %></td>
                <td><%= file.uploadTime %></td>
                <td><%= file.bytes %></td>
                <% if (!locals.updateFile) {%>
                    <% if (locals.user) {%>
                        <td>
                            <form action="/file/delete" method="post">
                                <input name="fileId" value="<%= file.id %>" hidden>
                                <input value="<%= currentFolder.id %>" name='redirectId' hidden>
                                <button>Delete</button>
                            </form>
                        </td>
                        <td>
                            <form action="/file/redirect/update" method="post">
                                <input name="fileId" value="<%= file.id %>" hidden>
                                <input value="<%= currentFolder.id %>" name='redirectId' hidden>
                                <button>Update</button>
                            </form>
                        </td>
                    <%}%>
                    <td colspan="<%= locals.user ? 1 : 3 %>">
                        <form action="<%= currentFolder.child ? "/file/download" : `/share/${currentFolder.id}/download` %>" method="post">
                            <input name="fileId" value="<%= file.id %>" hidden>
                            <input name="parentId" value="<%= currentFolder.id %>" hidden>
                            <input name="fileName" value="<%= file.name %>" hidden>
                            <button>Download</button>
                        </form>
                    </td>
                <%}%>
            </tr>
        <%}%>
        
    <%}%>
<%}%>