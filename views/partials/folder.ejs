<table>
    <thead>
        <tr>
            <td>Name</td>
            <td>Date Added</td>
            <td>Size</td>
            <td colspan="2">Actions</td>
        </tr>
    </thead>
    <tbody>
        <% const updateParentLink = locals.updateFolder ? `/update/${updateFolder.id}` : "" %>
        <% if (currentFolder.parentId) {%>
            <a href="/folder/<%= currentFolder.parentId + updateParentLink %>">../</a>
        <%}%>
        <% for (const folder of currentFolder.child) {%>
            <% const navLink = locals.updateFolder ? `/folder/${folder.id}/update/${updateFolder.id}` : `/folder/${folder.id}` %>
            <% const cSpan = locals.updateFolder ? 5 : 3 %>
            <tr>
                <% if (locals.updateFolder?.id !== folder.id) { %>
                    <td  colspan="<%= cSpan %>">
                        <a href="<%= navLink %>">
                            <%= folder.name %>
                        </a>
                    </td>
                <%}%>
                <% if (!locals.updateFolder) { %>
                    <td>
                        <form action="/folder/delete" method="post">
                            <input value="<%= folder.id %>" name='delFold' hidden>
                            <input value="<%= currentFolder.id %>" name='redirectId' hidden>
                            <button>Delete</button>
                        </form>
                    </td>
                    <td>
                        <a href="/folder/<%= currentFolder.id %>/update/<%= folder.id %>">
                            <button>Update</button>
                        </a>
                    </td>
                <%}%>
            </tr>
        <%}%>
        <%- include('files') %>
    </tbody>
</table>